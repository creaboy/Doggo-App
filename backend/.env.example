# MongoDB connection string
MONGO_URL=mongodb://localhost:27017

# Database name
DB_NAME=doggo_db

# (Optional) Comma-separated user IDs allowed to moderate walk reports.
# DOGGO_ADMIN_USER_IDS=user_your_id

# (Optional) Custom OSRM Routing URL (defaults to https://routing.openstreetmap.de)
# OSRM_ROUTING_BASE_URL=https://routing.openstreetmap.de
