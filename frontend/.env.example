# Backend URL
# Pour tester en local sur votre navigateur (Web) :
# EXPO_PUBLIC_BACKEND_URL=http://localhost:8000
#
# Pour tester sur votre smartphone avec Expo Go :
# Indiquez l'adresse IP locale de votre ordinateur sur le réseau Wi-Fi (ex: 192.168.1.50)
EXPO_PUBLIC_BACKEND_URL=http://192.168.1.50:8000

# ---------------------------------------------------------------------------
# Fond de carte (par défaut : OpenStreetMap / Leaflet, gratuit et SANS clé)
# ---------------------------------------------------------------------------
# Rien à configurer : l'app utilise les tuiles officielles OpenStreetMap
# (commerces, restaurants, parcs… affichés), sans compte ni clé API.
#
# (Optionnel) Pour un rendu encore plus proche de Google Maps (plus épuré) :
# demandez une clé CARTO gratuite (sans compte, https://carto.com/basemaps/apikey)
# puis renseignez-la ici. Le style "Voyager" sera utilisé.
EXPO_PUBLIC_CARTO_API_KEY=

# (Optionnel) Utiliser un autre fournisseur de tuiles XYZ compatible Leaflet :
# EXPO_PUBLIC_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png?key=VOTRE_CLE
# EXPO_PUBLIC_TILE_ATTRIBUTION=&copy; OpenStreetMap &copy; CARTO
# EXPO_PUBLIC_TILE_SUBDOMAINS=abcd
# EXPO_PUBLIC_TILE_CREDIT=CARTO Voyager

# ---------------------------------------------------------------------------
# Google Maps (100 % optionnel, nécessite un compte Google Cloud facturé)
# ---------------------------------------------------------------------------
# Si ces variables restent vides, l'app n'essaie même pas de charger Google Maps
# et utilise directement OpenStreetMap.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
# Clé "Browser" utilisée par la carte Google Maps JS (WebView iOS/Android et Web).
# Elle doit être identique à GOOGLE_MAPS_BROWSER_KEY côté backend (backend/.env).
EXPO_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
