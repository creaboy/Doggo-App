# Backend URL
# Pour tester en local sur votre navigateur (Web) :
# EXPO_PUBLIC_BACKEND_URL=http://localhost:8000
#
# Pour tester sur votre smartphone avec Expo Go :
# Indiquez l'adresse IP locale de votre ordinateur sur le réseau Wi-Fi (ex: 192.168.1.50)
EXPO_PUBLIC_BACKEND_URL=http://192.168.1.50:8000

# Liberty / OpenFreeMap fonctionne sans cle et est le fond par defaut.
# Optionnel : cle publique CARTO pour comparer avec Voyager dans le selecteur.
# Obtenir sa propre cle : https://www.carto.com/basemaps/apikey/
# Redemarrer Expo apres ajout ou modification de cette cle.
EXPO_PUBLIC_CARTO_API_KEY=
