# Backend URL
# Pour tester en local sur votre navigateur (Web) :
# EXPO_PUBLIC_BACKEND_URL=http://localhost:8000
#
# Pour tester sur votre smartphone avec Expo Go :
# Indiquez l'adresse IP locale de votre ordinateur sur le réseau Wi-Fi (ex: 192.168.1.50)
EXPO_PUBLIC_BACKEND_URL=http://192.168.1.50:8000

# ---------------------------------------------------------------------------
# Fond de carte (par défaut : OpenFreeMap "Liberty", vectoriel, SANS clé)
# ---------------------------------------------------------------------------
# Rien à configurer : l'app rend la carte avec MapLibre GL + OpenFreeMap
# (style "Liberty", très proche de Google Maps : fond clair, routes blanches,
# commerces/POI colorés), gratuit, sans compte ni clé. Si WebGL manque,
# repli automatique sur Leaflet / tuiles OpenStreetMap.
#
# (Optionnel) Style ultra-épuré (sans commerces) :
# EXPO_PUBLIC_MAP_STYLE=positron
#
# (Optionnel) Utiliser le style vectoriel CARTO Voyager avec une clé gratuite
# (https://carto.com/basemaps/apikey) :
EXPO_PUBLIC_CARTO_API_KEY=

# (Optionnel) Imposer n'importe quel style MapLibre (URL style.json) :
# EXPO_PUBLIC_MAP_STYLE_URL=https://exemple.org/style.json

# ---------------------------------------------------------------------------
# Google Maps (100 % optionnel, nécessite un compte Google Cloud facturé)
# ---------------------------------------------------------------------------
# Si ces variables restent vides, l'app n'essaie même pas de charger Google Maps
# et utilise directement OpenStreetMap.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
# Clé "Browser" utilisée par la carte Google Maps JS (WebView iOS/Android et Web).
# Elle doit être identique à GOOGLE_MAPS_BROWSER_KEY côté backend (backend/.env).
EXPO_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
